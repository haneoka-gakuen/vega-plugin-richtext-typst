{
  "name": "@haneoka/vega-plugin-richtext-typst",
  "version": "0.1.0",
  "description": "Safe, lazy Typst-to-SVG rich-text renderer for Vega",
  "keywords": [
    "visual-novel",
    "typst",
    "svg",
    "rich-text",
    "vega"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega-plugin-richtext-typst.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega-plugin-richtext-typst#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega-plugin-richtext-typst/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@haneoka/vega-plugin-richtext": "^0.1.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "dompurify": "3.4.12"
  },
  "peerDependencies": {
    "@haneoka/vega": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/vega": "workspace:*",
    "@haneoka/vega-plugin-richtext": "workspace:*",
    "typescript": "^6.0.3",
    "prettier": "3.7.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "vega": {
    "pluginApi": 1,
    "kind": "rich-text",
    "formats": [
      "typst",
      "typ"
    ],
    "capabilities": [
      "rich-text"
    ],
    "permissions": [
      "ui:dom"
    ],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
